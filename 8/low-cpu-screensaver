#!/usr/bin/env bash
#
# Tune the Omarchy screensaver: frame rate and which effects may play.
#
# Stock omarchy-screensaver runs the ttfx animation at 120fps in one fullscreen
# terminal per connected monitor, picking a random effect from everything ttfx
# knows. This rewrites those choices in place (the target is root-owned, so it
# prompts for sudo). Safe to re-run: exits quietly when the requested settings
# are already applied, and repairs a half-patched file where a bare frame
# count is left instead of `--frame-rate <n>`.

set -euo pipefail

target="/usr/share/omarchy/bin/omarchy-screensaver"

usage() {
  echo "Usage: low-cpu-screensaver [fps] [--effects <name>...] [--rain-time <seconds>]" >&2
  echo "  fps        frame rate for ttfx (default 30)" >&2
  echo "  --effects  restrict --random-effect to these ttfx effect names" >&2
  echo "  --rain-time  run one effect via its subcommand with rain this long and" >&2
  echo "               never resolve to the input text (needs exactly one effect)" >&2
  exit 2
}

fps=""
rain_time=""
effects=()
while (($#)); do
  case $1 in
    --effects)
      shift
      while (($#)) && [[ $1 != --* && $1 != [0-9]* ]]; do
        effects+=("$1")
        shift
      done
      ((${#effects[@]})) || usage
      ;;
    --rain-time)
      shift
      [[ ${1:-} =~ ^[0-9]+$ ]] || usage
      rain_time=$1
      shift
      ;;
    --help | -h)
      usage
      ;;
    [0-9]*)
      [[ -z $fps ]] || usage
      fps=$1
      shift
      ;;
    *)
      usage
      ;;
  esac
done
[[ -n $fps ]] || fps=30
if [[ -n $rain_time && ${#effects[@]} -ne 1 ]]; then
  echo "error: --rain-time needs exactly one --effects name" >&2
  exit 2
fi

if [[ ! -f $target ]]; then
  echo "error: $target not found - is Omarchy installed?" >&2
  exit 1
fi

# A wrong effect name makes ttfx exit immediately and the screensaver loop
# respawns it forever, so validate every name against `ttfx --help`.
if ((${#effects[@]})) && command -v ttfx >/dev/null; then
  help=$(ttfx --help 2>&1 || true)
  for name in "${effects[@]}"; do
    if ! grep -qE "^[[:space:]]+$name[[:space:]]" <<<"$help"; then
      echo "error: unknown ttfx effect '$name' (see: ttfx --help)" >&2
      exit 1
    fi
  done
fi

# Repair a half-patched file: a bare frame count where `--frame-rate <n>` used
# to be. ttfx treats that number as a subcommand, errors out, and the screensaver
# loop respawns it forever.
if ! grep -q -- '--frame-rate' "$target" && grep -qE '^[[:space:]]+[0-9]+ --canvas-width' "$target"; then
  bare=$(grep -E -o '^[[:space:]]+[0-9]+ --canvas-width' "$target" | grep -o '[0-9]\+' | head -1)
  echo "Repairing half-patched file: bare '$bare' -> '--frame-rate $bare' (sudo password may be required)"
  sudo sed -i -E 's/^([[:space:]]+)([0-9]+)( --canvas-width)/\1--frame-rate \2\3/' "$target"
fi

current=$(grep -o -- '--frame-rate [0-9]\+' "$target" | head -1 | grep -o '[0-9]\+' || true)

if [[ -n $current && $current != "$fps" ]]; then
  echo "Patching $target: frame-rate $current -> $fps (sudo password may be required)"
  sudo sed -i -E "s/--frame-rate [0-9]+/--frame-rate $fps/" "$target"
elif [[ -z $current ]]; then
  echo "error: no --frame-rate option found in $target - Omarchy changed?" >&2
  exit 1
fi

# Effect invocation: either a random pick from an include list, or a direct
# single-effect subcommand that rains forever without resolving to the text.
# Global flags (--no-eol, --no-restore-cursor) must come BEFORE a subcommand -
# after it, ttfx rejects them, dies instantly, and the screensaver respawns it
# forever. So rewrite the whole effect line in canonical order.
if ((${#effects[@]})) || [[ -n $rain_time ]]; then
  if [[ -n $rain_time ]]; then
    segment="--no-eol --no-restore-cursor ${effects[0]} --rain-time $rain_time"
  else
    segment="--random-effect --include-effects ${effects[*]} --no-eol --no-restore-cursor"
  fi
  # Known shapes: random pick, random pick + include list, and the direct form
  # (including the broken variant with globals after the subcommand).
  pattern="--no-eol --no-restore-cursor [a-z0-9]+ --rain-time [0-9]+|--random-effect( --include-effects [a-z0-9 ]+)? --no-eol --no-restore-cursor|[a-z0-9]+ --rain-time [0-9]+ --no-eol --no-restore-cursor"
  current_seg=$(grep -oE -- "$pattern" "$target" | head -1 || true)
  if [[ $current_seg != "$segment" ]]; then
    # Dry-run the candidate invocation in a pty before touching the real file:
    # an argument error here would make ttfx exit instantly and the screensaver
    # respawn-loop it forever.
    tmpin=$(mktemp)
    printf 'X' >"$tmpin"
    probe=$(timeout 3 script -qec "ttfx -i $tmpin --frame-rate 1 $segment" /dev/null 2>&1 || true)
    rm -f "$tmpin"
    if grep -qi 'error:' <<<"$probe"; then
      echo "error: dry-run of the new invocation failed, nothing changed:" >&2
      grep -i 'error:' <<<"$probe" | head -2 >&2
      exit 1
    fi
    echo "Patching $target: effect invocation -> $segment"
    sudo sed -i -E "s#^([[:space:]]+)(--random-effect|--no-eol|--no-restore-cursor|[a-z0-9]+).* &\$#\1${segment} \&#" "$target"
    after=$(grep -oE -- "$pattern" "$target" | head -1 || true)
    if [[ $after != "$segment" ]]; then
      echo "error: rewrite did not take effect in $target" >&2
      exit 1
    fi
  fi
fi

ok=true
grep -q -- "--frame-rate $fps" "$target" || ok=false
if [[ -n $rain_time ]]; then
  grep -q -- "--no-eol --no-restore-cursor ${effects[0]} --rain-time $rain_time" "$target" || ok=false
fi
if $ok; then
  echo "Applied: ${fps}fps"
  [[ -n $rain_time ]] && echo "Effect: ${effects[0]} --rain-time ${rain_time} (pure rain, no logo resolve)"
  ((${#effects[@]})) && [[ -z $rain_time ]] && echo "Effects restricted to: ${effects[*]}"
  echo "Test it with: omarchy-launch-screensaver force"
else
  echo "error: patch did not apply - check $target manually" >&2
  exit 1
fi
